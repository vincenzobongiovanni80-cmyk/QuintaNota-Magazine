---
interface Props { title?: string; description?: string; }
const {
  title = "Sanitaria Ortopedia di Elisabetta Zanghi — Torino",
  description = "Sanitaria e Ortopedia a Torino in Via Cherubini 22: busti, tutori, plantari, ausili, elettromedicali, noleggio e pratiche ASL e INAIL. Telefono 011 234 5678."
} = Astro.props;
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&family=Great+Vibes&display=swap" rel="stylesheet" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    "name": "Sanitaria Ortopedia di Elisabetta Zanghi",
    "description": "Sanitaria e ortopedia a Torino: busti e corsetti, tutori e ortesi, plantari e calzature ortopediche, ausili per incontinenza, elettromedicali, noleggio, pratiche ASL e INAIL.",
    "address": { "@type": "PostalAddress", "streetAddress": "Via Cherubini 22", "addressLocality": "Torino", "postalCode": "10154", "addressCountry": "IT" },
    "geo": { "@type": "GeoCoordinates", "latitude": 45.0925882, "longitude": 7.6970188 },
    "telephone": "+390112345678",
    "email": "info@ortopediatorino.esempio.it",
    "openingHours": ["Mo-Fr 09:00-13:00", "Mo-Fr 15:30-19:30", "Sa 09:00-13:00"]
  }
  </script>
  <style>
    :root {
      --teal: #205060;
      --teal-deep: #16394A;
      --teal-soft: #EDF4F5;
      --taupe: #A08070;
      --taupe-soft: #F5F0EC;
      --ink: #22303A;
      --muted: #5B6B74;
      --white: #FFFFFF;
      --wa: #1FAF54;
      --radius: 14px;
      --shadow: 0 10px 30px rgba(22, 57, 74, .10);
      --serif: "Cormorant Garamond", Georgia, serif;
      --sans: "Inter", system-ui, -apple-system, sans-serif;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { font-family: var(--sans); color: var(--ink); background: var(--white); line-height: 1.6; -webkit-font-smoothing: antialiased; }
    img { max-width: 100%; display: block; }
    a { color: inherit; }
    .wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
    section { padding: 88px 0; }
    .eyebrow { display: inline-block; font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--taupe); margin-bottom: 14px; }
    h1, h2, h3 { font-family: var(--serif); color: var(--teal-deep); line-height: 1.15; font-weight: 600; }
    h2 { font-size: clamp(30px, 4vw, 44px); margin-bottom: 18px; }
    h3 { font-size: 24px; }
    .lead { font-size: 18px; color: var(--muted); max-width: 720px; }
    .btn { display: inline-flex; align-items: center; gap: 10px; padding: 14px 26px; border-radius: 999px; font-weight: 600; font-size: 16px; text-decoration: none; border: 2px solid transparent; transition: transform .15s ease, box-shadow .15s ease, background .15s ease; cursor: pointer; }
    .btn:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
    .btn-primary { background: var(--teal); color: #fff; }
    .btn-primary:hover { background: var(--teal-deep); }
    .btn-outline { border-color: var(--teal); color: var(--teal); background: transparent; }
    .btn-outline:hover { background: var(--teal-soft); }
    .btn-wa { background: var(--wa); color: #fff; }
    .btn-wa:hover { background: #188a42; }

    /* Header */
    header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.92); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(22,57,74,.08); }
    .nav { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 12px 0; }
    .nav .logo img { height: 52px; width: auto; }
    .nav-links { display: flex; gap: 26px; list-style: none; }
    .nav-links a { text-decoration: none; font-size: 15px; font-weight: 500; color: var(--ink); }
    .nav-links a:hover { color: var(--teal); }
    .nav-cta { display: flex; gap: 12px; align-items: center; }
    .nav-cta .btn { padding: 10px 20px; font-size: 14px; }
    .menu-toggle { display: none; background: none; border: 0; cursor: pointer; }
    .menu-toggle svg { width: 30px; height: 30px; stroke: var(--teal-deep); }

    /* Hero */
    .hero { position: relative; padding: 0; min-height: 88vh; display: flex; align-items: center; color: #fff; overflow: hidden; }
    .hero::before { content: ""; position: absolute; inset: 0; background: url("/hero.jpg") center/cover no-repeat; }
    .hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(100deg, rgba(22,57,74,.92) 0%, rgba(32,80,96,.78) 45%, rgba(32,80,96,.25) 100%); }
    .hero .wrap { position: relative; z-index: 2; padding-top: 96px; padding-bottom: 96px; }
    .hero .logo-h { height: 92px; width: auto; margin-bottom: 26px; filter: drop-shadow(0 4px 14px rgba(0,0,0,.25)); }
    .hero h1 { color: #fff; font-size: clamp(38px, 5.4vw, 62px); max-width: 640px; margin-bottom: 18px; }
    .hero h1 em { font-style: normal; color: #E8CDBB; }
    .hero p { font-size: 19px; max-width: 560px; color: rgba(255,255,255,.92); margin-bottom: 34px; }
    .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
    .hero-badges { display: flex; gap: 26px; margin-top: 44px; flex-wrap: wrap; }
    .hero-badges div { display: flex; align-items: center; gap: 10px; font-size: 14.5px; font-weight: 500; color: rgba(255,255,255,.92); }
    .hero-badges svg { width: 22px; height: 22px; flex: none; }

    /* Trust strip */
    .trust { background: var(--taupe-soft); padding: 26px 0; }
    .trust .wrap { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
    .trust span { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 15px; color: var(--teal-deep); }
    .trust svg { width: 24px; height: 24px; flex: none; }

    /* ASL/INAIL */
    .asl { background: linear-gradient(180deg, var(--teal-soft), #fff); }
    .asl-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 56px; align-items: start; }
    .asl-card { background: #fff; border-radius: var(--radius); box-shadow: var(--shadow); padding: 38px; }
    .steps { list-style: none; counter-reset: step; margin-top: 8px; }
    .steps li { counter-increment: step; position: relative; padding: 20px 0 20px 74px; border-bottom: 1px dashed rgba(22,57,74,.15); }
    .steps li:last-child { border-bottom: 0; }
    .steps li::before { content: counter(step); position: absolute; left: 0; top: 18px; width: 48px; height: 48px; border-radius: 50%; background: var(--teal); color: #fff; font-family: var(--serif); font-size: 24px; font-weight: 700; display: grid; place-items: center; }
    .steps strong { display: block; font-size: 17px; color: var(--teal-deep); margin-bottom: 4px; }
    .steps p { font-size: 15px; color: var(--muted); }
    .note { margin-top: 22px; background: var(--taupe-soft); border-left: 4px solid var(--taupe); border-radius: 8px; padding: 16px 20px; font-size: 15px; color: var(--ink); }

    /* Prodotti */
    .prod-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 40px; }
    .prod-card { background: #fff; border: 1px solid rgba(22,57,74,.10); border-radius: var(--radius); padding: 26px 22px; transition: transform .15s ease, box-shadow .15s ease; }
    .prod-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: rgba(32,80,96,.25); }
    .prod-card svg { width: 38px; height: 38px; margin-bottom: 16px; }
    .prod-card h3 { font-size: 19px; margin-bottom: 6px; }
    .prod-card p { font-size: 14px; color: var(--muted); }

    /* Chi siamo */
    .about { background: var(--teal-soft); }
    .about-grid { display: grid; grid-template-columns: .95fr 1.05fr; gap: 56px; align-items: center; }
    .about img { border-radius: var(--radius); box-shadow: var(--shadow); }
    .script { font-family: "Great Vibes", cursive; font-size: 34px; color: var(--taupe); display: block; margin-top: 10px; }
    .check-list { list-style: none; margin-top: 22px; }
    .check-list li { display: flex; gap: 12px; padding: 8px 0; font-size: 16px; }
    .check-list svg { width: 22px; height: 22px; flex: none; margin-top: 3px; }

    /* Contatti */
    .contact-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 44px; align-items: start; margin-top: 44px; }
    .contact-info { display: grid; gap: 14px; }
    .info-card { display: flex; gap: 16px; align-items: flex-start; background: #fff; border: 1px solid rgba(22,57,74,.10); border-radius: var(--radius); padding: 18px 20px; text-decoration: none; transition: box-shadow .15s ease; }
    .info-card:hover { box-shadow: var(--shadow); }
    .info-card svg { width: 26px; height: 26px; flex: none; margin-top: 2px; }
    .info-card strong { display: block; font-size: 13px; text-transform: uppercase; letter-spacing: .1em; color: var(--taupe); margin-bottom: 2px; }
    .info-card span { font-size: 17px; font-weight: 600; color: var(--teal-deep); }
    .info-card small { display: block; font-size: 14px; color: var(--muted); font-weight: 400; }
    .map-embed { border: 0; width: 100%; height: 300px; border-radius: var(--radius); box-shadow: var(--shadow); margin-top: 6px; }
    form.quote { background: #fff; border: 1px solid rgba(22,57,74,.10); border-radius: var(--radius); box-shadow: var(--shadow); padding: 34px; display: grid; gap: 16px; }
    form.quote h3 { margin-bottom: 2px; }
    .field label { display: block; font-size: 13.5px; font-weight: 600; color: var(--teal-deep); margin-bottom: 6px; }
    .field input, .field textarea, .field select { width: 100%; padding: 12px 14px; border: 1.5px solid rgba(22,57,74,.18); border-radius: 10px; font: inherit; font-size: 15px; color: var(--ink); background: #fff; }
    .field input:focus, .field textarea:focus, .field select:focus { outline: 2px solid rgba(32,80,96,.35); border-color: var(--teal); }
    .privacy { font-size: 13px; color: var(--muted); display: flex; gap: 10px; align-items: flex-start; }
    .privacy input { margin-top: 4px; }
    .form-note { display: none; background: #E6F6EE; border: 1px solid #B9E5CB; color: #14663B; padding: 14px 16px; border-radius: 10px; font-size: 15px; }

    /* CTA band + footer */
    .cta-band { background: linear-gradient(120deg, var(--teal-deep), var(--teal)); color: #fff; text-align: center; }
    .cta-band h2 { color: #fff; }
    .cta-band p { color: rgba(255,255,255,.88); max-width: 620px; margin: 0 auto 30px; font-size: 18px; }
    .cta-band .hero-actions { justify-content: center; }
    footer { background: var(--teal-deep); color: rgba(255,255,255,.78); padding: 56px 0 30px; font-size: 14.5px; }
    footer .foot-grid { display: flex; justify-content: space-between; gap: 30px; flex-wrap: wrap; align-items: flex-start; }
    footer img { height: 64px; width: auto; margin-bottom: 14px; }
    footer a { color: #fff; text-decoration: none; }
    footer a:hover { text-decoration: underline; }
    .foot-bottom { border-top: 1px solid rgba(255,255,255,.15); margin-top: 36px; padding-top: 22px; display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; font-size: 13px; color: rgba(255,255,255,.55); }

    /* WhatsApp float */
    .wa-float { position: fixed; right: 22px; bottom: 22px; z-index: 60; width: 60px; height: 60px; border-radius: 50%; background: var(--wa); display: grid; place-items: center; box-shadow: 0 8px 24px rgba(0,0,0,.25); transition: transform .15s ease; }
    .wa-float:hover { transform: scale(1.08); }
    .wa-float svg { width: 32px; height: 32px; fill: #fff; }

    @media (max-width: 940px) {
      .prod-grid { grid-template-columns: repeat(2, 1fr); }
      .asl-grid, .about-grid, .contact-grid { grid-template-columns: 1fr; gap: 36px; }
      .nav-links, .nav-cta .btn-outline { display: none; }
      .menu-toggle { display: block; }
      .nav-links.open { display: flex; position: absolute; top: 100%; left: 0; right: 0; background: #fff; flex-direction: column; padding: 18px 24px 22px; gap: 14px; border-bottom: 1px solid rgba(22,57,74,.1); box-shadow: var(--shadow); }
      section { padding: 64px 0; }
      .hero { min-height: 0; }
    }
    @media (max-width: 560px) {
      .prod-grid { grid-template-columns: 1fr; }
      .hero .logo-h { height: 66px; }
      form.quote, .asl-card { padding: 24px; }
    }
  </style>
</head>
<body>
  <slot />
  <script>
    const t = document.querySelector('.menu-toggle');
    const l = document.querySelector('.nav-links');
    t?.addEventListener('click', () => l.classList.toggle('open'));
    l?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => l.classList.remove('open')));
    // Form: success message if Formspree ID is configured, otherwise graceful fallback
    const form = document.querySelector('form.quote');
    form?.addEventListener('submit', async (e) => {
      const action = form.getAttribute('action') || '';
      if (!action.includes('formspree.io/f/') || action.includes('TUO-ID')) {
        e.preventDefault();
        const n = document.querySelector('.form-note');
        n.style.display = 'block';
        n.textContent = 'Il modulo sarà attivo a breve. Nel frattempo scrivici su WhatsApp o chiamaci: ti rispondiamo subito!';
        n.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      e.preventDefault();
      const data = new FormData(form);
      const res = await fetch(action, { method: 'POST', body: data, headers: { 'Accept': 'application/json' } });
      const n = document.querySelector('.form-note');
      n.style.display = 'block';
      if (res.ok) { n.textContent = 'Richiesta inviata! Ti ricontatteremo al più presto. Grazie.'; form.reset(); }
      else { n.textContent = 'Qualcosa non ha funzionato. Riprova o scrivici su WhatsApp.'; }
      n.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  </script>
</body>
</html>
